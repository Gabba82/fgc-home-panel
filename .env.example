# Puerto publicado por Docker. Cambia si ya tienes otro servicio en 8099.
FGC_EXTERNAL_PORT=8099

# Zona horaria para calcular horarios. Usa valores de IANA (ej. Europe/Madrid).
FGC_TIMEZONE=Europe/Madrid

# Caché en memoria (segundos). Reduce llamadas a la API de FGC.
FGC_CACHE_TTL_SECONDS=30

# Timeout HTTP al consultar FGC (segundos).
FGC_HTTP_TIMEOUT_SECONDS=8

# Nivel de logs: DEBUG, INFO, WARNING, ERROR.
FGC_LOG_LEVEL=INFO

# Textos del encabezado. Deja FGC_PANEL_SUBTITLE vacío para ocultarlo.
FGC_PANEL_TITLE=Pròxims trens
FGC_PANEL_SUBTITLE=

# URL base de la API de FGC (no cambiar salvo que FGC cambie el endpoint).
# FGC_API_BASE_URL=https://dadesobertes.fgc.cat/api/explore/v2.1/catalog/datasets

# Paradas AMB visibles en el panel. Separa varias con comas.
# Si queda vacío, no se muestran tarjetas de bus.
FGC_BUS_STOP_IDS=

# Credenciales opcionales de TMB/AMB para mejorar datos de iBus.
FGC_AMB_APP_ID=5b1fdf3a
# FGC_AMB_APP_KEY=
